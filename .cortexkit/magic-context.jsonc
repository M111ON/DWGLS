{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "sidekick": {
    "model": "9router/working",
    "fallback_models": [
      "9router/working"
    ]
  },
  "memory": {
    "injection_budget_tokens": 12500,
    "git_commit_indexing": {
      "enabled": true,
      "max_commits": 5000
    }
  },
  "embedding": {
    "provider": "local",
    "model": "Xenova/multilingual-e5-small",
    "local_dtype": "int8"
  },
  "execute_threshold_percentage": 58,
  "prompt_surface": {
    "default": "full"
  },
  "caveman_text_compression": {
    "enabled": true,
    "min_chars": 500
  },
  "dreamer": {
    "tasks": {
      "map-memories": {
        "schedule": "0 2 * * *"
      },
      "verify": {
        "schedule": "0 3 * * *"
      },
      "maintain-docs": {
        "schedule": "0 3 * * *"
      }
    }
  },
  "history_budget_percentage": 0.25
}
