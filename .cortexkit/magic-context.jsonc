{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "sidekick": {
    "model": "9router/oc/mimo-v2.5-free",
    "fallback_models": [
      "9router/openrouter/openrouter/free"
    ]
  },
  "dreamer": {
    "opencode": {
      "model": "9router/oc/mimo-v2.5-free",
      "fallback_models": [
        "9router/openrouter/openrouter/free"
      ]
    },
    "tasks": {
      "retrospective": {
        "schedule": "0 5 * * *"
      },
      "classify-memories": {
        "schedule": "0 6 * * *"
      },
      "map-memories": {
        "schedule": ""
      },
      "maintain-docs": {
        "schedule": "0 3 * * *"
      }
    }
  },
  "memory": {
    "injection_budget_tokens": 9500
  }
}
